{
  "name": "habitat-blueprint",
  "version": "0.1.0",
  "private": true,
  "description": "A free, private, accessible planning tool for Planet Zoo 2 players. Unofficial and fan-made.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file=astro.env node_modules/astro/bin/astro.mjs dev",
    "build": "node scripts/licenses.mjs --write && node --env-file=astro.env node_modules/astro/bin/astro.mjs build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "node --env-file=astro.env node_modules/astro/bin/astro.mjs check && tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "idb": "8.0.4",
    "immer": "11.1.21",
    "lz-string": "1.5.0",
    "nanoid": "6.0.2",
    "polygon-clipping": "0.15.7",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "7.1.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "astro": "7.4.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
