{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs --port 4330",
      "startServerReadyPattern": "Serving dist",
      "url": [
        "http://localhost:4330/HabitatBlueprint/",
        "http://localhost:4330/HabitatBlueprint/help/",
        "http://localhost:4330/HabitatBlueprint/planner/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["is-on-https", "redirects-http", "uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
