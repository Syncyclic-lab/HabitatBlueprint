---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroDemo from '../components/site/HeroDemo.astro';
import HabitatVignette from '../components/site/HabitatVignette.astro';
import Icon from '../components/site/Icon.astro';
import type { IconId } from '../assets/icons/icons';
import { en } from '../i18n/en';
import { withBase } from '../config/site';

const t = en.landing;
const [leadFeature, ...otherFeatures] = t.features.items;
const featureIcons: IconId[] = ['layers', 'tool-barrier', 'paw', 'print'];
---

<BaseLayout title={en.pages.home.title} fullTitle>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="page hero-grid">
      <div>
        <h1 id="hero-heading">{t.h1}</h1>
        <p class="hero-lead">{t.lead}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={withBase('/planner')}>
            {t.primaryCta}
          </a>
          <a class="text-link" href="#how-it-works">
            {t.secondaryCta}
          </a>
        </div>
      </div>
      <HeroDemo />
    </div>
  </section>

  <section class="band band-surface" aria-labelledby="features-heading">
    <div class="page">
      <h2 id="features-heading">{t.features.heading}</h2>
      <div class="features">
        <div class="feature-lead">
          <h3>{leadFeature?.title}</h3>
          <p>{leadFeature?.body}</p>
          <HabitatVignette />
        </div>
        <ul class="feature-list" role="list">
          {otherFeatures.map((f, i) => (
            <li>
              <Icon id={featureIcons[i] ?? 'paw'} size={44} class="pictogram" />
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="how-it-works">
    <div class="page">
      <h2 id="how-it-works" tabindex="-1">
        {t.how.heading}
      </h2>
      <ol class="steps">
        {t.how.steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="band band-surface">
    <div class="page split">
      <section aria-labelledby="everyone-heading">
        <h2 id="everyone-heading">{t.everyone.heading}</h2>
        <p>{t.everyone.body}</p>
        <p>
          <a href={withBase('/accessibility')}>{t.everyone.link}</a>
        </p>
      </section>
      <section aria-labelledby="privacy-heading">
        <h2 id="privacy-heading">{t.privacy.heading}</h2>
        <p>{t.privacy.body}</p>
        <p>
          <a href={withBase('/privacy')}>{t.privacy.link}</a>
        </p>
      </section>
    </div>
  </div>

  <section class="band" aria-labelledby="faq-heading">
    <div class="page">
      <h2 id="faq-heading">{t.faq.heading}</h2>
      <div class="faq">
        {t.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
