---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../planner/boot/boot.css';
import { PlannerApp } from '../planner/App.tsx';
import { en } from '../i18n/en';
import { withBase } from '../config/site';

const t = en.pages.planner;
const b = t.boot;
---

<BaseLayout title={t.title} description={t.description} variant="app">
  {/*
    React Aria injects a <style id="react-aria-pressable-style"> unless an element with that id
    already exists. Our CSP blocks injected styles, so this placeholder makes it skip, and the
    same rule lives in planner.css.
  */}
  <template id="react-aria-pressable-style"></template>
  <div class="planner-host">
    <div
      id="boot-screen"
      class="boot-screen"
      data-stage="download"
      data-label-download={b.download}
      data-label-start={b.start}
      data-label-storage={b.storage}
      data-label-open={b.open}
      data-label-draw={b.draw}
      data-label-ready={b.ready}
      data-label-error={b.error}
    >
      <div class="boot-card">
        <svg class="boot-art" viewBox="0 0 120 84" role="img" aria-label={b.artLabel}>
          <rect x="1" y="1" width="118" height="82" rx="10" class="ground"></rect>
          <path d="M1 58 H119 M78 1 V83" class="path"></path>
          <path d="M8 8 H48 Q56 8 56 16 V48 H8 Z" class="done-habitat"></path>
          <ellipse cx="36" cy="32" rx="9" ry="6" class="pond"></ellipse>
          <path d="M86 8 L112 8 L112 40 L94 50 L86 50 Z" class="tracing"></path>
          <circle cx="86" cy="8" r="2.6" class="vertex"></circle>
          <circle cx="112" cy="8" r="2.6" class="vertex"></circle>
          <circle cx="112" cy="40" r="2.6" class="vertex"></circle>
          <circle cx="94" cy="50" r="2.6" class="vertex"></circle>
        </svg>
        <h1>{b.heading}</h1>
        <div class="boot-progress">
          <div class="boot-row">
            <span data-boot-label aria-live="polite">
              {b.download}
            </span>
            <span data-boot-pct aria-hidden="true">
              0%
            </span>
          </div>
          <progress max="100" value="0" aria-label={b.progress}></progress>
          <span class="boot-detail" data-boot-detail aria-hidden="true"></span>
        </div>
        <div class="boot-error">
          <p>{b.error}</p>
          <a class="btn btn-primary" href={withBase('/planner')}>
            {b.reload}
          </a>
        </div>
        <noscript>
          <p class="notice">{t.noscriptBody}</p>
        </noscript>
      </div>
    </div>
    <PlannerApp client:progress />
  </div>
</BaseLayout>
