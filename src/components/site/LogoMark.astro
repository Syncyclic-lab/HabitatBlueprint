---
/** Decorative site mark: a map tile with one habitat and a path. Our own drawing. */
---

<svg
  class="logo-mark"
  viewBox="0 0 32 32"
  width="32"
  height="32"
  aria-hidden="true"
  focusable="false"
>
  <rect x="1" y="1" width="30" height="30" rx="7" class="logo-ground"></rect>
  <path d="M1 21 H31" class="logo-path"></path>
  <path d="M6 5 H20 L25 10 V16 H6 Z" class="logo-habitat"></path>
  <path d="M9 26 H15 V31" class="logo-path-thin"></path>
</svg>
