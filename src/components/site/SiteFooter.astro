---
/** Site footer: the non-affiliation disclaimer and the same links, in the same order, on every page. */
import { en } from '../../i18n/en';
import { REPO_URL, withBase } from '../../config/site';

const links = [
  { href: withBase('/privacy'), label: en.nav.privacy },
  { href: withBase('/terms'), label: en.nav.terms },
  { href: withBase('/accessibility'), label: en.nav.accessibility },
  { href: withBase('/credits'), label: en.nav.credits },
  { href: withBase('/help'), label: en.nav.help },
];
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <nav aria-label={en.site.footerNavLabel}>
      <ul class="footer-nav" role="list">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
        <li>
          <a href={REPO_URL} rel="noopener noreferrer">
            {en.site.openSource}
          </a>
        </li>
      </ul>
    </nav>
    <p class="disclaimer">{en.site.disclaimer}</p>
  </div>
</footer>
